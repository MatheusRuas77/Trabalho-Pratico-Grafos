@startuml
title Diagrama de Casos de Uso - Ferramenta de Detecção de Fraudes
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Analista de\nConformidade" as Analista
actor "Dataset IBM AML\n(arquivos CSV)" as Dataset <<sistema externo>>

rectangle "Ferramenta de Detecção de Fraudes em Grafos" {
  usecase "Carregar dados de transações" as UC1
  usecase "Definir recorte\n(período / nº de transações)" as UC2
  usecase "Construir grafo de transações" as UC3
  
  usecase "Executar detector de fraudes" as UC_Base
  usecase "Executar detector de\nlavagem circular (ciclos)" as UC4
  usecase "Executar detector de\ngrupos fechados (SCC)" as UC5
  usecase "Executar detector de\nconta laranja" as UC6
  
  usecase "Ajustar parâmetros\ndos detectores" as UC7
  usecase "Visualizar contas e\nsubgrafos suspeitos" as UC8
  usecase "Ver ranking de\nscore de suspeita" as UC9
  usecase "Avaliar resultados\n(precisão e recall)" as UC10
  usecase "Medir desempenho\n(tempo de execução)" as UC11
}

Analista --> UC1
Analista --> UC2
Analista --> UC_Base
Analista --> UC9
Analista --> UC10
Analista --> UC11

UC_Base <|-- UC4
UC_Base <|-- UC5
UC_Base <|-- UC6

UC1 ..> UC3 : <<include>>
UC9 ..> UC_Base : <<include>>

UC7 ..> UC_Base : <<extend>>
UC8 ..> UC_Base : <<extend>>

UC1 -- Dataset
UC10 -- Dataset : usa rótulos
@enduml