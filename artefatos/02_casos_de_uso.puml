@startuml
title Diagrama de Casos de Uso - Ferramenta de Detecção de Fraudes
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #F4F4F4

actor "Analista de\nConformidade" as Analista
actor "Dataset IBM AML\n(arquivos CSV)" as Dataset <<sistema externo>>

rectangle "Ferramenta de Detecção de Fraudes em Grafos" {
  usecase "Carregar dados de transações\ne metadados de contas" as UC_Carregar
  usecase "Construir grafo direcionado\nde transações" as UC_Grafo
  usecase "Definir recorte da base\n(limite de transações)" as UC_Recorte

  usecase "Executar detecção e análise\nde padrões suspeitos" as UC_Executar
  usecase "Detectar contas intermediárias,\npontes e passagem rápida" as UC_Laranja
  usecase "Detectar componentes conexos\n(fracos e fortes / SCC)" as UC_SCC
  usecase "Detectar lavagem circular\n(ciclos temporais)" as UC_Ciclos
  usecase "Analisar graus de entrada/saída\n(Fan-In / Fan-Out)" as UC_Graus

  usecase "Ajustar parâmetros\ndos detectores" as UC_Params
  usecase "Consultar resumo e rankings\nde métricas de suspeita" as UC_Rankings
  usecase "Visualizar contas, vizinhança\ne subgrafos suspeitos" as UC_Visualizar
}

Analista -- UC_Carregar
Analista -- UC_Recorte
Analista -- UC_Executar
Analista -- UC_Rankings
Analista -- UC_Visualizar

UC_Carregar -- Dataset

UC_Carregar ..> UC_Grafo : <<include>>
UC_Rankings ..> UC_Executar : <<include>>
UC_Params ..> UC_Executar : <<extend>>
UC_Visualizar ..> UC_Rankings : <<extend>>

UC_Laranja -|> UC_Executar
UC_SCC -|> UC_Executar
UC_Ciclos -|> UC_Executar
UC_Graus -|> UC_Executar
@enduml